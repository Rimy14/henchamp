{
  "name": "digital-printing-pos-erp",
  "version": "1.0.0",
  "description": "Point of Sale and ERP System for Digital Printing Shop",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:import": "node scripts/import_db.js",
    "db:reset": "node scripts/reset_and_import_db.js",
    "grant:admin": "node scripts/grant_admin_all_permissions.js",
    "update:prices": "node scripts/update_item_selling_prices.js",
    "isp:migrate": "node scripts/isp/run_isp_migrations.js",
    "isp:verify-db": "node scripts/isp/run_isp_migrations.js --verify",
    "isp:seed": "node scripts/isp/seed_isp_demo.js",
    "isp:seed:reset": "node scripts/isp/seed_isp_demo.js --reset",
    "isp:simulate": "node scripts/isp/simulate_radius_session.js",
    "isp:verify": "node scripts/isp/verify_isp_api.js",
    "isp:test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/isp-*.test.js --forceExit"
  },
  "keywords": [
    "pos",
    "erp",
    "printing",
    "inventory",
    "sales"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
