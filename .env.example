# Server Configuration
PORT=7001
NODE_ENV=development


# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=henchamp_pos_db
DB_PORT=3306
DB_CONNECTION_LIMIT=10


# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d


# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourcompany.com


# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads


# Application
APP_NAME=HenChamp ISP + POS
APP_URL=http://localhost:7001


# Printing
# Show Print Preview (true/false)
SHOW_PRINT_PREVIEW=false

# Enable QZ Tray for Direct Thermal Receipt Printing (true/false)
ENABLE_QZ_TRAY=false



# ==================================
# ISP Configuration
# ==================================

# ISP Background Jobs
ISP_JOBS_ENABLED=false

# Recurring billing interval
# Default: 24 hours
# Testing: 10000
ISP_BILLING_INTERVAL_MS=86400000


# System user used for automated ISP invoices
# Must exist in users table
ISP_SYSTEM_USER_ID=1



# ==================================
# M-Pesa Daraja Configuration
# ==================================

# Enable real Daraja API
# false = mock mode
MPESA_ENABLED=false


# Safaricom Daraja Credentials
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=


# Business details
MPESA_SHORTCODE=
MPESA_PASSKEY=


# Callback endpoint
MPESA_CALLBACK_URL=http://localhost:7001/api/payment/daraja/callback



# ==================================
# ISP Security
# ==================================

ISP_ENCRYPTION_KEY=